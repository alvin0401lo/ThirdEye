# Copy to .env and keep the real API key and device token private.
OPENAI_API_KEY=
# Replace these placeholders with model IDs available to your API account.
THIRDEYE_OPENAI_MODEL=YOUR_ROUTING_MODEL
THIRDEYE_VISION_MODEL=YOUR_VISION_MODEL
THIRDEYE_TRANSCRIBE_MODEL=gpt-live-transcribe

# Current test architecture: ESP32 video/IMU with PC microphone and speaker.
THIRDEYE_CAMERA_SOURCE=esp32
THIRDEYE_AUDIO_SOURCE=pc
THIRDEYE_CAMERA_INDEX=1
THIRDEYE_CAMERA_WIDTH=1280
THIRDEYE_CAMERA_HEIGHT=720
THIRDEYE_CAMERA_HOST=0.0.0.0
THIRDEYE_CAMERA_PORT=8081
THIRDEYE_CAMERA_TIMEOUT=5
THIRDEYE_CAMERA_TOKEN=YOUR_PRIVATE_TOKEN
THIRDEYE_MIRROR_HAND_VIEW=false
# Width/height above apply to USB cameras, not ESP32 stream resolution.

THIRDEYE_CUE_AUDIO_DIR=audio_cues
THIRDEYE_MODEL_PATH=yoloe-26s-seg.pt
THIRDEYE_TRACKER=bytetrack.yaml
THIRDEYE_CONFIDENCE=0.20
THIRDEYE_IMAGE_SIZE=640
THIRDEYE_HAND_SCALE=0.8
THIRDEYE_GUIDANCE_REPEAT_S=1.5
THIRDEYE_LANGUAGE=en
THIRDEYE_WAKE_WORD=hi third eye
THIRDEYE_WAKE_LANGUAGE=en-US
THIRDEYE_WAKE_CONFIDENCE=0.70
THIRDEYE_WAKE_MODEL=small.en
THIRDEYE_MICROPHONE_DEVICE=
THIRDEYE_SPEAKER_DEVICE=
THIRDEYE_VOICE_RATE=0
# Optional companion website relay; empty disables it.
THIRDEYE_COMPANION_BRIDGE_URL=
THIRDEYE_COMPANION_ROOM=THIRDEYE
